# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Editor
.DS_Store
.idea/
.vscode/
*~

# Project outputs
outputs/
slurm_logs/
*.out
*.err
*.pt
*.ckpt

# Whitelist the trained model weights + JSON reports + final figures so the
# grader sees results immediately on clone. The model is small (~400 KB) and
# the JSON files / PNGs are tiny.
!outputs/
!outputs/model.pt
!outputs/*.json
!outputs/*.yaml
!outputs/figures/
!outputs/figures/*.png

# Word lock files (created when a .docx is open in Word/Pages). Never commit.
~$*

# Sweep working dirs (large; only the winning run is promoted into outputs/)
outputs/sweep/

# Data (don't commit raw data to git)
data/raw/
data/processed/
data/*.csv
data/*.parquet

# Whitelist the bundled milestone-demo data so the notebook runs after a
# fresh clone without needing Talapas / FRED access. Generated by
# scripts/export_examples.py and intentionally committed.
!data/example/
!data/example/**
!data/example/*.pt

# Notebooks
.ipynb_checkpoints/

# Local secrets
.env

# Local cleanup staging (safe to delete)
_archive/
